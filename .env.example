# API Keys for Eleusis LLM Benchmark

# Required for the default rule compiler in config.yaml
HF_TOKEN=hf_your_token_here

# Optional: only set this if you want Hugging Face Inference Providers billed to
# a Hugging Face organization instead of your personal account.
# HF_BILL_TO=your_org_name

# Cloud API keys for various providers
GOOGLE_API_KEY=<your_google_api_key_here>
OPENAI_API_KEY=<your_openai_api_key_here>
ANTHROPIC_API_KEY=<your_anthropic_api_key_here>
XAI_API_KEY=<your_xai_api_key_here>
