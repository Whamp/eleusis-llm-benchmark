# API Keys for Eleusis LLM Benchmark

# OpenRouter: required by the default rule compiler in config.yaml (primary
# Novita route and all fallback routes).
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional: Hugging Face Inference Providers, if you use a huggingface-
# provider rule compiler instead of the OpenRouter default.
# HF_TOKEN=hf_your_token_here
# HF_BILL_TO=your_org_name

# Cloud API keys for various providers
GOOGLE_API_KEY=<your_google_api_key_here>
OPENAI_API_KEY=<your_openai_api_key_here>
ANTHROPIC_API_KEY=<your_anthropic_api_key_here>
XAI_API_KEY=<your_xai_api_key_here>
